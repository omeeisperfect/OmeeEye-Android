<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings for the missing-core editors (SLIDE_LIST / QS_TILE /
  POWER_DIALOG steps, insert-at-position, per-step cycles, area-click
  modes, paste sources, launch-app search, color anchor, image
  template preview). All English only. Never edit strings.xml or
  strings_missing_core.xml for these; this file is the only home for
  editor strings added by this layer.
-->
<resources>
    <string name="step_slide_list">Slide list</string>
    <string name="step_slide_list_desc">Scroll a list up or down, repeatedly</string>
    <string name="step_qs_tile">Quick setting tile</string>
    <string name="step_qs_tile_desc">Open Quick Settings and tap a tile</string>
    <string name="step_power_dialog">Power dialog</string>
    <string name="step_power_dialog_desc">Open the system power dialog</string>

    <string name="editor_insert_position_title">Insert position</string>
