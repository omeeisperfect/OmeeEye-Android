    <string name="color_anchor_pick">Pick anchor point</string>
    <string name="color_anchor_none">No anchor point picked</string>
    <string name="color_anchor_picked">Anchor picked at (%1$d, %2$d)</string>
    <string name="color_anchor_guide_title">How to set up the anchor</string>
    <string name="color_anchor_guide_message">Move to the screen that shows the color you want to watch, then tap the exact point whose color should be watched. That point becomes the anchor: at run time only the pixel at the anchor is checked, instead of searching a whole region. Cancel stops without picking anything; Save starts the on-screen pick.</string>
    <string name="color_anchor_never_show">Never show again</string>
    <string name="color_anchor_failed">Could not read the color at that point</string>
    <string name="color_anchor_service_missing">Accessibility service is not available, so the anchor color could not be read</string>

