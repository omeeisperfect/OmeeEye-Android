    <string name="slide_count_title">Slides</string>

    <string name="qs_tile_title">Quick setting tile</string>
    <string name="qs_tile_note">Android does not provide an API to list the tiles actually present on this device, so this list offers standard tile names. If the chosen tile is not on this device, the step fails cleanly instead of pretending success.</string>

    <string name="power_dialog_title">Power dialog</string>
    <string name="power_dialog_note">This step opens the system power dialog. Android does not allow an app to inject a power-button long-press, so this is the closest alternative.</string>

    <string name="area_mode_title">Area click mode</string>
    <string name="area_mode_random">One random point</string>
