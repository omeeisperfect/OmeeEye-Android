<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AMOLED dark theme: TRUE BLACK, never slate grey.
         Same color names as values/colors.xml, so every layout that
         uses @color/... switches automatically in night mode.
         Cards are #111111 at most; the tint is a dark green, not grey. -->
    <color name="background">#000000</color>
    <color name="card_background">#111111</color>
    <color name="card_active">#10B981</color>
    <color name="card_active_text">#000000</color>
    <color name="card_active_sub">#0B3D2E</color>
    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#B3B3B3</color>
    <color name="accent">#34D399</color>
    <color name="accent_text">#000000</color>
    <color name="danger">#FF6B66</color>
    <color name="overlay_bar">#2F3B52</color>
    <color name="overlay_bar_text">#FFFFFF</color>
    <color name="banner_start">#FFB020</color>
    <color name="banner_end">#FF7A1A</color>
    <color name="divider">#262626</color>
    <color name="card_border">#262626</color>
    <color name="icon_tint_background">#14281F</color>
</resources>
