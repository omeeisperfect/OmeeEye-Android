<?xml version="1.0" encoding="utf-8"?>
<!-- One sub-action row inside the recognition editor (success, retry, or
     after-retry lists), reference shape: round icon + title (tapping
     reopens its configuration, i.e. the picker) + list icon + red
     delete icon. No coordinate input exists here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/row_card_ref"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/sub_action_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/circle_icon_bg"
        android:padding="2dp" />

    <TextView
        android:id="@+id/sub_action_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:textColor="@color/ref_title"
        android:textSize="15sp" />

    <ImageButton
        android:id="@+id/sub_action_list"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/rec_sub_list_desc"
        android:src="@android:drawable/ic_menu_sort_by_size"
        android:tint="@color/ref_title" />

    <ImageButton
        android:id="@+id/sub_action_delete"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/rec_delete"
        android:src="@android:drawable/ic_menu_delete"
        android:tint="@color/ref_red" />
</LinearLayout>
