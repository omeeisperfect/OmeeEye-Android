<?xml version="1.0" encoding="utf-8"?>
<!-- ADD menu bottom sheet, reference light theme: white sheet, dark
     title, green CLOSE pill at the bottom. Row/group layouts carry
     the same light colors. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ref_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_step_title"
        android:textColor="@color/ref_title"
        android:textSize="20sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/add_step_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_close_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/ref_green"
        android:text="@string/close"
        android:textColor="#FFFFFF"
        app:cornerRadius="24dp" />
</LinearLayout>
