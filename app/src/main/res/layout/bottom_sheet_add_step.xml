<?xml version="1.0" encoding="utf-8"?>
<!-- ADD menu bottom sheet, reference light theme: white sheet, small
     green CLOSE pill at the bottom-right. Row/group layouts carry
     the same light colors. The light dialog theme is forced in
     AddStepBottomSheet.getTheme(), so the sheet surround stays light
     even when the rest of the app runs dark/AMOLED. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ref_card"
    android:orientation="vertical"
    android:padding="12dp">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/add_step_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <Button
        android:id="@+id/btn_close_sheet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/ref_green"
        android:minHeight="36dp"
        android:minWidth="0dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:text="@string/close"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:cornerRadius="24dp" />
</LinearLayout>
