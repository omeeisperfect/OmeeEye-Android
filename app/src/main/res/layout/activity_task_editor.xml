<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ref_page_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Workflow name (mirrors the name field below). -->
        <TextView
            android:id="@+id/editor_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ref_title"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Pencil: focuses the name field so the workflow can be renamed. -->
        <ImageButton
            android:id="@+id/btn_name_edit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editor_rename_desc"
            android:src="@android:drawable/ic_menu_edit"
            android:tint="@color/ref_title" />

        <!-- "?": short help dialog describing the editor. -->
        <TextView
            android:id="@+id/btn_editor_help"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/editor_help_desc"
            android:gravity="center"
            android:text="?"
            android:textColor="@color/ref_green"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Top 3-dot menu (workflow-level actions such as Data…). -->
        <ImageButton
            android:id="@+id/btn_editor_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editor_data"
            android:src="@android:drawable/ic_menu_more"
            android:tint="@color/ref_title" />
    </LinearLayout>

    <!-- Workflow NAME (a name, not a location, so typing it is fine). -->
    <EditText
        android:id="@+id/workflow_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/workflow_name_hint"
        android:inputType="text"
        android:singleLine="true"
        android:textColor="@color/ref_title"
        android:textColorHint="@color/ref_summary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/step_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />

    <!-- Bottom bar, reference order. Behaviour is unchanged: ADD opens
         the add-step sheet, CANCEL discards, SAVE persists and finishes.
         SAVE is the filled green pill button. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_add"
            style="@style/OutlineButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:textColor="@color/ref_title"
            android:textSize="14sp"
            android:text="@string/editor_add"
            app:strokeColor="@color/ref_summary" />

        <Button
            android:id="@+id/btn_cancel"
            style="@style/OutlineButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:textColor="@color/ref_title"
            android:textSize="14sp"
            android:text="@string/editor_cancel"
            app:strokeColor="@color/ref_summary" />

        <Button
            android:id="@+id/btn_save"
            style="@style/FilledButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/ref_green"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:textSize="14sp"
            android:text="@string/editor_save"
            app:cornerRadius="24dp" />
    </LinearLayout>
</LinearLayout>
