<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ref_page_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Workflow name, renamed via the pencil dialog. -->
        <TextView
            android:id="@+id/editor_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ref_title"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Pencil: opens the rename dialog (the old duplicate name
             field below the header is gone, so this is the rename path). -->
        <ImageButton
            android:id="@+id/btn_name_edit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editor_rename_desc"
            android:padding="12dp"
            android:src="@drawable/ic_ref_edit"
            android:tint="@color/ref_title" />

        <!-- "?": short help dialog describing the editor. -->
        <TextView
            android:id="@+id/btn_editor_help"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/editor_help_desc"
            android:gravity="center"
            android:text="?"
            android:textColor="@color/ref_green"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/step_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />

    <!-- Empty state: shown only when the step list is empty (the
         activity toggles this view against the list). -->
    <TextView
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/editor_empty_no_content"
        android:textColor="@color/ref_summary"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Bottom bar, reference order. Behaviour is unchanged: ADD opens
         the add-step sheet, CANCEL discards, SAVE persists and finishes.
         SAVE is the filled green pill button. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_add"
            style="@style/OutlineButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:textColor="@color/ref_title"
            android:textSize="14sp"
            android:text="@string/editor_add"
            app:strokeColor="@color/ref_summary" />

        <Button
            android:id="@+id/btn_cancel"
            style="@style/OutlineButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:textColor="@color/ref_title"
            android:textSize="14sp"
            android:text="@string/editor_cancel"
            app:strokeColor="@color/ref_summary" />

        <Button
            android:id="@+id/btn_save"
            style="@style/FilledButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/ref_green"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:textSize="14sp"
            android:text="@string/editor_save"
            app:cornerRadius="24dp" />
    </LinearLayout>
</LinearLayout>
