<?xml version="1.0" encoding="utf-8"?>
<!-- Transparent full-screen point picker. pick_root covers the screen; a
     tap anywhere on it (except the Cancel button) picks that point. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pick_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true">

    <TextView
        android:id="@+id/pick_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:background="#CC2F3B52"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:text="@string/pick_hint"
        android:textColor="@color/overlay_bar_text"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btn_pick_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:text="@string/cancel" />

</FrameLayout>
