<?xml version="1.0" encoding="utf-8"?>
<!-- Transparent full-screen gesture recorder. record_touch_area covers the
     screen and is the ONLY view whose touches are recorded; the hint label
     (not clickable, so touches fall through to the touch area) and the Done
     button (consumes its own clicks) sit above it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/record_touch_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/record_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:background="#CC2F3B52"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:text="@string/record_hint"
        android:textColor="@color/overlay_bar_text"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btn_record_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:text="@string/done" />

</FrameLayout>
