<?xml version="1.0" encoding="utf-8"?>
<!-- MaterialCardView is used instead of androidx.cardview.widget.CardView:
     the cardview artifact is not in this project's dependencies, while
     MaterialCardView ships with the material dependency that is available. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/ref_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/ref_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/workflow_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ref_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/workflow_interval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/ref_summary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/workflow_cycles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/ref_summary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Plain play affordance (reference style): smaller than the
             old 48dp green circle, no filled background — just the
             play triangle in reference green. Id and click handling
             are unchanged, so Play still runs the workflow. -->
        <ImageButton
            android:id="@+id/btn_play"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Play"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_play"
            android:tint="@color/ref_green" />

        <ImageButton
            android:id="@+id/btn_card_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Card menu"
            android:src="@android:drawable/ic_menu_more" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
