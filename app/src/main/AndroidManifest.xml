<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Overlay windows (floating bars) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Foreground service for the floating bars -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Battery exemption so a run is not killed mid-way (user grants it in Settings) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.TaskEditorActivity" />
        <activity android:name=".ui.SettingsActivity" />
        <activity android:name=".ui.HistoryActivity" />
        <activity android:name=".ui.TrashActivity" />

        <!-- Base-v2 section screens (placeholder content, see each activity). -->
        <activity android:name=".ui.TriggersActivity" />
        <activity android:name=".ui.HideActivity" />
        <activity android:name=".ui.LibraryActivity" />

        <!-- Transparent overlay: tap anywhere to pick a point. Returns x/y, never typed. -->
        <activity
            android:name=".ui.PickPointActivity"
            android:theme="@style/TranslucentTheme" />

        <!-- Transparent overlay: records the user's taps/swipes into steps. -->
        <activity
            android:name=".ui.RecordActivity"
            android:theme="@style/TranslucentTheme" />

        <service
            android:name=".engine.AutomationService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".ui.FloatingService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

    </application>

</manifest>
