<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Overlay windows (floating bars) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Foreground service for the floating bars -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Battery exemption so a run is not killed mid-way (user grants it in Settings) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Network request (GET only) step -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Triggers: SMS keyword trigger -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Triggers: restart the trigger watchers after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Hide Mode: dialer-code unhide (best effort on Android 10+, see HideActivity) -->
    <uses-permission android:name="android.permission.PROCESS_OUTGOING_CALLS" />
    <!-- Triggers: exact time alarms (falls back to inexact when denied) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Package visibility (Android 11+): without this, queryIntentActivities
         only returns system apps, so Launch App never lists user apps.
         This is NOT QUERY_ALL_PACKAGES — only launcher apps are visible. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ui.OmeeEyeApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.TaskEditorActivity" />
        <activity android:name=".ui.SettingsActivity" />
        <activity android:name=".ui.HistoryActivity" />
        <activity android:name=".ui.TrashActivity" />

        <!-- Triggers / Hide / Library section screens (real since the
             12-feature build; see each activity). -->
        <activity android:name=".ui.TriggersActivity" />
        <activity android:name=".ui.HideActivity" />
        <activity android:name=".ui.LibraryActivity" />

        <!-- Recognition step editor (normal app theme). -->
        <activity
            android:name=".ui.RecognitionEditActivity"
            android:exported="false" />

        <!-- Screenshot preview (Wave-1 contract: started with
             FLAG_ACTIVITY_NEW_TASK + "path" extra by the runner). -->
        <activity
            android:name=".ui.ScreenshotPreviewActivity"
            android:exported="false" />

        <!-- Image share for the screenshot preview (FileProvider). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.nimu.omeeeye.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Overlay pick/record service: picks and records OVER other
             apps via a system overlay window (the old translucent pick
             activities could only ever show this app's own screen). -->
        <service
            android:name=".ui.OverlayPickService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Button capture overlay ("All buttons") and gesture path
             viewer: same foreground-service + overlay pattern as
             OverlayPickService. -->
        <service
            android:name=".ui.ButtonCaptureService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <service
            android:name=".ui.GesturePathService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <service
            android:name=".engine.AutomationService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".ui.FloatingService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Trigger watchers (foreground service + notification listener). -->
        <service
            android:name=".engine.TriggerEngine"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <service
            android:name=".engine.TriggerNotificationService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Trigger receivers (system broadcasts / explicit intents only). -->
        <receiver
            android:name=".engine.SmsTriggerReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".engine.OutgoingCallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.NEW_OUTGOING_CALL" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".engine.BootTriggerReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".engine.TimeTriggerReceiver"
            android:exported="false" />

        <receiver
            android:name=".engine.AutoUnhideReceiver"
            android:exported="false" />

    </application>

</manifest>
